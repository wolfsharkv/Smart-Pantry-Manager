<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules file for Android 12 (API level 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include shared preferences and databases in cloud backups -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <!-- Include shared preferences and databases in device-to-device transfers -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
